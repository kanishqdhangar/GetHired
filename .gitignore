# Ignore Python cache and compiled files
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.pkl
*.log

# Ignore environment and secret files
.env
.env.local
.env.*
!env.example

# Ignore virtual environment folders
venv/
env/
.venv/

# Ignore system files
.DS_Store
Thumbs.db

# Ignore IDE and editor settings
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Ignore build and dependency folders
build/
dist/
*.egg-info/
.eggs/
node_modules/

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore temporary or generated files
*.tmp
*.bak
*.swp
*.swo
*.~lock*

# Ignore data files (optional — if you keep large datasets locally)
data/
datasets/
*.csv
*.xlsx
*.json
